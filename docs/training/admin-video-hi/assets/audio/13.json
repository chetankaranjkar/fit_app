[
  {
    "start": 0.1,
    "end": 3.2605263,
    "text": "रोज़ पाँच बातें याद रखें।"
  },
  {
    "start": 3.2105263,
    "end": 5.6052631,
    "text": "डैशबोर्ड देखें।"
  },
  {
    "start": 5.6052632,
    "end": 9.1447369,
    "text": "नए मेंबर की ऑनबोर्डिंग पूरी करें।"
  },
  {
    "start": 9.1447369,
    "end": 11.8421053,
    "text": "पेमेंट और रसीद मिलाएँ।"
  },
  {
    "start": 11.8421054,
