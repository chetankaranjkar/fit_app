{
  "UseSqlite": false,
  "Database": {
    "AutoMigrate": true
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "GymManagement",
    "Audience": "GymManagement",
    "AccessTokenMinutes": 480,
    "RefreshTokenDays": 14
  },
  "DoorDevice": {
    "Enabled": false
  },
  "Notifications": {
    "EnableScheduledReminders": false,
    "EnableInAppMembershipExpiryReminders": true,
    "ReminderIntervalHours": 24,
    "MembershipExpiryReminderDays": 14,
    "InAppMembershipExpiryReminderDays": 14,
    "EmailWebhookUrl": "",
    "WhatsAppWebhookUrl": ""
  }
}
